__pycache__
*egg-info

/DandelionMusic.spec
/build
/dist

/config.json
/config/config_comments.json
/settings.db
/data/*
!/data/.gitkeep
/music/*
!/music/.gitkeep
/log.txt
.env
.idea/
/.cache
backup
.venv
.superpowers/

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# Session handoff documents - see CLAUDE.md's "Workflow" section. Local
# to one machine's working sessions, so the directory is tracked and its
# contents are not.
/handoffs/*
!/handoffs/.gitkeep

# Real cookies files: only the placeholder is tracked.
/config/cookies/*
!/config/cookies/cookies.txt
